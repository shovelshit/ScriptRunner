<?xml version="1.0" encoding="utf-8"?>
<!--
    默认布局：适用于手机以及平板竖屏（未命中 layout-sw600dp-land 分栏布局时）。
    通过 res/values(-sw600dp)/dimens.xml 中的尺寸资源自动适配手机与平板的字号/间距，
    并用 content_max_width 限制单栏内容的最大宽度，避免宽屏下每行文字被拉得过长。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center_horizontal"
        android:maxWidth="@dimen/content_max_width"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center_vertical"
                android:text="@string/app_name"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold" />

            <Button
                android:id="@+id/button_check_update"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="@string/button_check_update"
                android:textColor="#3F51B5"
                android:textSize="@dimen/text_size_input" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/main_disclaimer"
            android:textColor="#FF6D00"
            android:textSize="@dimen/text_size_disclaimer" />

        <!-- ADB 连接状态 + 提权状态 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_adb_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#EEEEEE"
                android:padding="8dp"
                android:textIsSelectable="true"
                android:textSize="@dimen/text_size_status" />

            <TextView
                android:id="@+id/text_elevation_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="#EEEEEE"
                android:padding="8dp"
                android:textIsSelectable="true"
                android:textSize="@dimen/text_size_status" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#EEEEEE"
            android:padding="8dp"
            android:textIsSelectable="true"
            android:textSize="@dimen/text_size_status" />

        <!-- 远端配置拉取入口 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_remote_config"
            android:textSize="@dimen/text_size_label"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/edit_remote_url"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:autofillHints=""
                android:hint="@string/hint_remote_url"
                android:inputType="textUri"
                android:maxLines="1"
                android:textSize="@dimen/text_size_input" />

            <Button
                android:id="@+id/button_fetch_remote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/button_fetch_remote" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center_vertical"
                android:text="@string/label_script_list"
                android:textSize="@dimen/text_size_label"
                android:textStyle="bold" />

            <Button
                android:id="@+id/button_refresh_scripts"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/button_refresh_scripts" />

            <Button
                android:id="@+id/button_run_now"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/button_run_now" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_script_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center_vertical"
                android:text="@string/label_recent_log"
                android:textSize="@dimen/text_size_label"
                android:textStyle="bold" />

            <Button
                android:id="@+id/button_refresh_log"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/button_refresh_log" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/scroll_log"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:background="#F5F5F5">

            <TextView
                android:id="@+id/text_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:padding="8dp"
                android:textIsSelectable="true"
                android:textSize="@dimen/text_size_log" />
        </ScrollView>

    </LinearLayout>

</FrameLayout>
