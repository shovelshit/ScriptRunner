<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 下载的 APK 存放在 getExternalFilesDir(null)/updates/ 下，
         对应 external-files-path（不是 external-path，后者映射的是 /sdcard/ 根目录） -->
    <external-files-path name="update_apk" path="updates/" />
    <!-- 兼容 getFilesDir() 私有目录场景 -->
    <files-path name="update_apk_internal" path="updates/" />
</paths>
