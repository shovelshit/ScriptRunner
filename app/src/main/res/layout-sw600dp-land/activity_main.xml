<?xml version="1.0" encoding="utf-8"?>
<!--
    平板横屏专用布局（宽度 >= 600dp 且横屏）：
    左右分栏——左侧放配置/脚本列表，右侧放执行日志，充分利用横屏下的宽度，
    避免手机竖屏那种单栏纵向堆叠在平板横屏下显得列表区域过窄、日志区域被过度拉伸的问题。
    控件 id 与默认布局保持一致，MainActivity 无需区分布局即可正常工作。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:text="@string/app_name"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold" />

        <Button
            android:id="@+id/button_check_update"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="@string/button_check_update"
            android:textColor="#3F51B5"
            android:textSize="@dimen/text_size_input" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/main_disclaimer"
        android:textColor="#FF6D00"
        android:textSize="@dimen/text_size_disclaimer" />

    <!-- ADB 连接状态 + 提权状态 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_adb_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#EEEEEE"
                android:padding="8dp"
                android:textIsSelectable="true"
                android:textSize="@dimen/text_size_status" />

            <TextView
                android:id="@+id/text_elevation_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="#EEEEEE"
                android:padding="8dp"
                android:textIsSelectable="true"
                android:textSize="@dimen/text_size_status" />
        </LinearLayout>

        <!-- 通知监听权限状态（点击跳转设置授权「通知使用权」） -->
        <TextView
            android:id="@+id/text_notif_listener_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#EEEEEE"
            android:padding="8dp"
            android:textIsSelectable="true"
            android:textSize="@dimen/text_size_status" />

        <TextView
            android:id="@+id/text_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#EEEEEE"
            android:padding="8dp"
            android:textIsSelectable="true"
            android:textSize="@dimen/text_size_status" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- 左栏：远端配置拉取 + 脚本列表 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_remote_config"
                android:textSize="@dimen/text_size_label"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/edit_remote_url"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:autofillHints=""
                    android:hint="@string/hint_remote_url"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:textSize="@dimen/text_size_input" />

                <Button
                    android:id="@+id/button_fetch_remote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/button_fetch_remote" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_gravity="center_vertical"
                    android:text="@string/label_script_list"
                    android:textSize="@dimen/text_size_label"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/button_refresh_scripts"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/button_refresh_scripts" />

                <Button
                    android:id="@+id/button_run_now"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/button_run_now" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_script_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:layout_weight="1" />

        </LinearLayout>

        <!-- 分隔线 -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="20dp"
            android:background="#DDDDDD" />

        <!-- 右栏：执行日志 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_gravity="center_vertical"
                    android:text="@string/label_recent_log"
                    android:textSize="@dimen/text_size_label"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/button_refresh_log"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/button_refresh_log" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/scroll_log"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:layout_weight="1"
                android:background="#F5F5F5">

                <TextView
                    android:id="@+id/text_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:padding="8dp"
                    android:textIsSelectable="true"
                    android:textSize="@dimen/text_size_log" />
            </ScrollView>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
